  {
   "name": "Grammar Basics",
   "description": "Particles and endings, with fill-the-blank practice",
   "symbol": "문",
   "cards": [
    {
     "ko": "-은/는",
     "en": "topic marker",
     "notes": "은 after a consonant, 는 after a vowel. Marks what the sentence is about, often with a sense of contrast.",
     "example": "저는 학생이에요.",
     "exampleEn": "I am a student.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-이/가",
     "en": "subject marker",
     "notes": "이 after a consonant, 가 after a vowel. Marks the subject, often new information.",
     "example": "비가 와요.",
     "exampleEn": "It's raining.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-을/를",
     "en": "object marker",
     "notes": "을 after a consonant, 를 after a vowel.",
     "example": "사과를 먹어요.",
     "exampleEn": "I eat an apple.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-에",
     "en": "to (a place); at (a time)",
     "notes": "Destination with 가다 and 오다, or a point in time.",
     "example": "세 시에 만나요.",
     "exampleEn": "Let's meet at three.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-에서",
     "en": "at; in (where something happens)",
     "notes": "Marks the place where an action takes place. Also means 'from' a place.",
     "example": "카페에서 공부해요.",
     "exampleEn": "I study at a café.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-고 싶다",
     "en": "to want to (do)",
     "notes": "Verb stem + 고 싶다. Polite: 고 싶어요.",
     "example": "한국에 가고 싶어요.",
     "exampleEn": "I want to go to Korea.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-아요/어요",
     "en": "polite present ending",
     "notes": "Stems whose last vowel is ㅏ or ㅗ take 아요, the rest take 어요, and 하다 becomes 해요.",
     "example": "친구를 만나요.",
     "exampleEn": "I meet a friend.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-았어요/었어요",
     "en": "polite past ending",
     "notes": "Same vowel rule as the present: 갔어요, 먹었어요, 했어요.",
     "example": "어제 영화를 봤어요.",
     "exampleEn": "I watched a movie yesterday.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "-(으)ㄹ 거예요",
     "en": "will (future)",
     "notes": "Stem + ㄹ 거예요 after a vowel, 을 거예요 after a consonant.",
     "example": "내일 친구를 만날 거예요.",
     "exampleEn": "I will meet a friend tomorrow.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "안 + verb",
     "en": "not (short negation)",
     "notes": "Put 안 before the verb. For 하다 verbs it goes before 하다: 공부 안 해요. The longer form is stem + 지 않아요.",
     "example": "저는 커피를 안 마셔요.",
     "exampleEn": "I don't drink coffee.",
     "tags": [
      "grammar"
     ],
     "type": "grammar"
    },
    {
     "ko": "저{{는::topic particle}} 학생이에요.",
     "en": "I am a student.",
     "notes": "는 is the topic particle after a vowel.",
     "tags": [
      "particles"
     ],
     "type": "sentence"
    },
    {
     "ko": "사과{{를::object particle}} 먹어요.",
     "en": "I eat an apple.",
     "notes": "를 is the object particle after a vowel.",
     "tags": [
      "particles"
     ],
     "type": "sentence"
    },
    {
     "ko": "비{{가::subject particle}} 와요.",
     "en": "It's raining.",
     "notes": "가 is the subject particle after a vowel.",
     "tags": [
      "particles"
     ],
     "type": "sentence"
    },
    {
     "ko": "학교{{에}} 가요.",
     "en": "I go to school.",
     "notes": "에 marks the destination; it is a particle.",
     "tags": [
      "particles"
     ],
     "type": "sentence"
    },
    {
     "ko": "카페{{에서}} 공부해요.",
     "en": "I study at a café.",
     "notes": "에서 marks where an action happens; it is a particle.",
     "tags": [
      "particles"
     ],
     "type": "sentence"
    },
    {
     "ko": "한국에 가{{고 싶어요::want to}}.",
     "en": "I want to go to Korea.",
     "notes": "Verb stem + 고 싶어요.",
     "tags": [
      "endings"
     ],
     "type": "sentence"
    },
    {
     "ko": "어제 영화를 {{봤어요::보다, past}}.",
     "en": "I watched a movie yesterday.",
     "notes": "보 + 았어요 contracts to 봤어요.",
     "tags": [
      "endings"
     ],
     "type": "sentence"
    }
   ]
  }
 ]
